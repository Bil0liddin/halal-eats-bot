# Telegram
BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN
ADMIN_TELEGRAM_IDS=111111111,222222222

# Toss Payments (test keys from https://developers.tosspayments.com)
TOSS_CLIENT_KEY=test_ck_REPLACE_ME
TOSS_SECRET_KEY=test_sk_REPLACE_ME

# Public base URL of the FastAPI backend (used to build Toss checkout/redirect links)
# For local dev, expose with ngrok/cloudflared and put that URL here, e.g. https://abcd1234.ngrok-free.app
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./halal_orders.db
